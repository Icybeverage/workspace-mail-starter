# Workspace Launch environment. Copy to .env and fill in real values.
# NEVER commit a filled-in .env. All values below are placeholders.

# --- server ---
NODE_ENV=development
PORT=3210
HOST=127.0.0.1
# Served under this path; the reverse proxy must match (e.g. https://mail.example.test/launch).
BASE_PATH=/launch
# Exact browser origin allowed for state-changing requests (CSRF origin check).
# Leave empty in dev (same-origin is derived from the request host).
APP_ORIGIN=
EXTRA_ORIGINS=
DATA_DIR=data
DB_PATH=
SESSION_TTL_DAYS=14

# --- vault (required for Cloudflare automation) ---
# 32 bytes as 64 hex chars or base64. Generate: openssl rand -hex 32
VAULT_KEY=

# --- Mail server admin API (server-side only; never exposed to clients) ---
MAIL_SERVER_BASE_URL=https://mail.example.test/admin
MAIL_SERVER_USERNAME=
MAIL_SERVER_PASSWORD=
MAIL_SERVER_TIMEOUT_MS=15000
# Hostname of the mail server's MX target; defaults to the MAIL_SERVER_BASE_URL hostname.
MAIL_SERVER_MAIL_HOST=

# --- optional outgoing relay sender authentication ---
# When configured, custom domains must be authenticated before activation.
# The key is server-side only and is never returned, logged, or stored in SQLite.
WORKSPACE_RELAY_PROVIDER=
SENDGRID_API_KEY=
SENDGRID_API_BASE=https://api.sendgrid.com/v3
SENDGRID_TIMEOUT_MS=10000

# --- product behavior ---
HOSTED_DOMAIN=example.test
MAILBOX_LIMIT_PER_ACCOUNT=1
GLOBAL_MAILBOX_CAP=50
# Comma-separated local parts reserved for the operator on the hosted domain.
RESERVED_LOCALPARTS=admin,administrator,product,postmaster,abuse,support,security,hostmaster,webmaster,root,mailer-daemon,noreply,no-reply,info,billing,help,mail,email,dns,mx,notifications,alerts,team,teams,sales,contact

# --- Neo4j graph projection (optional; UI shows a degraded badge when unavailable) ---
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# --- Optional OpenAI-compatible LLM for assistant explanations only ---
# When unset, the setup assistant runs in honest "Rule-based setup assistant" mode.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- rate limits (requests per window) ---
RATE_LOGIN_LIMIT=10
RATE_SIGNUP_LIMIT=5
RATE_MAILBOX_LIMIT=10
RATE_PROVISION_LIMIT=30
RATE_AGENT_LIMIT=20
RATE_INSPECT_LIMIT=60

# --- dev tooling ---
DEV_PORT=5173

# Build-time brand: export this value when running npm run build.
VITE_BRAND_NAME=Workspace Mail
# Explicit host pin for optional read-only harness checks.
LIVE_ALLOWED_HOST=mail.example.test
